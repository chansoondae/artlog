rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artlog_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /artlog_rooms/{roomId} {
      allow read: if request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.ownerId
        || (request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['memberIds']));
      allow delete: if request.auth.uid == resource.data.ownerId;

      match /members/{memberUid} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/artlog_rooms/$(roomId)).data.memberIds;
        allow write: if request.auth.uid == memberUid;
      }
      match /logs/{logId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/artlog_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/artlog_rooms/$(roomId)).data.memberIds
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth.uid == resource.data.authorId;
      }
    }
  }
}
